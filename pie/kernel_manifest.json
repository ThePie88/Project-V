          "type",
          "content",
          "source_refs"
        ],
        "title": "MemoryRecord",
        "type": "object"
      },
      "schema_fingerprint": "87443b54f184d1f4eb0999982e34d0b7d25e17bffb26c18be952316b7207c425"
    },
