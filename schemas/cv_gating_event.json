{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CVGatingEvent",
  "description": "V6a-R5 CV gating event — one ControlVector channel affecting one pipeline decision",
  "type": "object",
  "required": ["type", "canale", "valore", "decisione", "effetto", "reason"],
  "properties": {
    "type": {
      "type": "string",
      "const": "CV_GATING"
    },
    "canale": {
      "type": "string",
      "enum": ["tool_gate", "memory_gate", "verbosity_bias", "consolidation_urgency", "cf_k"]
    },
    "valore": {
      "type": "number"
    },
    "decisione": {
      "type": "string"
    },
    "effetto": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
