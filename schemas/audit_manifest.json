{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Bundle Manifest (V6b-E4)",
  "description": "Root manifest for deterministic audit bundles with SHA-256 hash chain.",
  "type": "object",
  "required": [
    "schema_version",
    "kernel_version",
    "session_id",
    "files",
    "root_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "kernel_version": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "root_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "volatile_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
